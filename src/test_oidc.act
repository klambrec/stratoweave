"""Signed RS256 fixtures exercise OIDC protocol security boundaries.

Fixture signatures were generated with OpenSSL; the private key is discarded.
All validation uses the fixed timestamp 1700000000, never the wall clock.
"""
import oidc
import oidc_crypto
import testing

