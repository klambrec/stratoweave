def settings() -> oidc.Settings:
    return oidc.Settings("https://issuer.example", "client", "secret", "https://app.example/auth/oidc/callback", ["openid"])


def original() -> oidc.TokenSet:
    return oidc.TokenSet("user-123", "", "", "https://issuer.example", 1700000300.0, "access", "refresh", TOKENS["valid"], "nonce", 1699999990, ["client"])


def _test_valid_signed_identity():
    claims = oidc.validate_id_token(TOKENS["valid"], [KEY], settings(), "nonce", 1700000000)
    testing.assertEqual(oidc.string(claims, "sub"), "user-123")


def _test_signed_invalid_claims():
    for name in ["issuer", "audience", "extra_audience", "nonce", "expired", "future", "not_before", "subject", "azp", "no_nonce", "alg", "crit", "unknown_kid"]:
        try:
            oidc.validate_id_token(TOKENS[name], [KEY], settings(), "nonce", 1700000000)
        except oidc.PermanentError:
            pass
        else:
            raise ValueError("Expected rejection: " + name)


def _test_signature_and_key_checks():
    parts = TOKENS["valid"].split(".")
    signature = oidc_crypto.decode_base64url(parts[2])
    signature = (b"x" if signature[0] != 120 else b"y") + signature[1:]
    tampered = parts[0] + "." + parts[1] + "." + oidc_crypto.base64url(signature)
    try:
        oidc.validate_id_token(tampered, [KEY], settings(), "nonce", 1700000000)
    except oidc.PermanentError:
        pass
    else:
        raise ValueError("Expected signature rejection")
    for keys in [[KEY, KEY], []]:
        try:
            oidc.validate_id_token(TOKENS["valid"], keys, settings(), "nonce", 1700000000)
        except oidc.PermanentError:
            pass
        else:
            raise ValueError("Expected ambiguous/missing key rejection")
    testing.assertFalse(oidc_crypto.verify_rs256(b"text", b"signature", b"short", b"\x01\x00\x01"))


def _test_refresh_identity_continuity():
    # OIDC refresh may omit nonce, but cannot change the authenticated identity.
    oidc.validate_id_token(TOKENS["no_nonce"], [KEY], settings(), "nonce", 1700000000, original())
    for name in ["refresh_subject", "refresh_auth_time", "nonce"]:
        try:
            oidc.validate_id_token(TOKENS[name], [KEY], settings(), "nonce", 1700000000, original())
        except oidc.PermanentError:
            pass
        else:
            raise ValueError("Expected refresh identity rejection")


def _test_ambiguous_json_and_endpoint_rejected():
    for raw in [b'{"iss":"a","iss":"b"}', b'{"s":"x\\u0000y"}', b'{"i\\u0073s":"a","iss":"b"}']:
        testing.assertFalse(oidc_crypto.json_document_valid(raw))
    for url in ["http://issuer.example", "https://user@issuer.example", "https://issuer.example/#fragment", "https://issuer.example:0", "https://issuer.example\\evil", "https://issuer.example:65536"]:
        try:
            oidc.endpoint(url, True)
        except oidc.PermanentError:
            pass
        else:
            raise ValueError("Expected endpoint rejection")
    testing.assertEqual(oidc.endpoint("http://oidc.localhost:5556/dex", True).host, "oidc.localhost")
    testing.assertEqual(oidc.endpoint("https://issuer.example/path?name=value").path, "/path")
    try:
        oidc.endpoint("http://localhost:5556/dex")
    except oidc.PermanentError:
        pass
    else:
        raise ValueError("Expected HTTP disabled by default")
